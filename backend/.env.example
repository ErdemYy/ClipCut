GEMINI_API_KEY=
MOCK_AI=auto
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
# Ücretsiz alternatif: free-ken-burns (anahtarsız stok görsel + yerel FFmpeg, Veo çağrısı yok).
VEO_MODEL=veo-3.0-fast-generate-001
# Üretim öncesi seçilebilecek ek modeller (virgülle ayrılmış).
# Varsayılan model her zaman listeye eklenir; erişim sağlayıcı hesabına bağlıdır.
TEXT_MODEL_OPTIONS=gemini-3.8-flash
VEO_MODEL_OPTIONS=free-ken-burns,veo-3.0-fast-generate-001,veo-3.0-generate-001
# Ücretsiz video görsel kaynağı: auto | picsum | pexels | pixabay | pollinations
# auto, PEXELS_API_KEY / PIXABAY_API_KEY tanımlıysa onları dener; yoksa hızlı Picsum'a düşer.
FREE_IMAGE_PROVIDER=auto
# Ücretsiz stok API anahtarları (isteğe bağlı; anahtarsız Picsum çalışır).
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Pollinations ücretsiz kotası için isteğe bağlı token.
POLLINATIONS_TOKEN=
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
